{
  "keybindings": {
    "Normal": {
      // Quit
      "<q>": "Quit",
      "<f10>": "Quit",
      "<Ctrl-c>": "Quit",
      "<Ctrl-z>": "Suspend",

      // Navigation
      "<up>": "NavUp",
      "<k>": "NavUp",
      "<down>": "NavDown",
      "<j>": "NavDown",
      "<pageup>": "NavPageUp",
      "<pagedown>": "NavPageDown",
      "<home>": "NavTop",
      "<end>": "NavBottom",
      "<enter>": "NavEnter",
      "<right>": "NavEnter",
      "<backspace>": "NavParent",
      "<left>": "NavParent",
      "<tab>": "SwitchPanel",
      "<backtab>": "SyncPanelDir",

      // Marking
      "<space>": "ToggleMark",
      "<insert>": "ToggleMark",

      // Operations — F-keys plus shift-letter fallbacks for terminals/compositors
      // that intercept function keys (e.g. COSMIC desktop).
      "<f1>": "QuickCd",
      "<shift-f1>": "RecentDirs",
      "<f2>": "ContextMenu",      "<shift-x>": "ContextMenu",
      "<f3>": "View",             "<shift-e>": "View",
      "<f4>": "CalcSizes",        "<shift-z>": "CalcSizes",
      "<f5>": "Copy",             "<shift-y>": "Copy",
      "<f6>": "Move",             "<shift-r>": "Move",
      "<shift-f6>": "Rename",
      "<f7>": "Mkdir",            "<shift-k>": "Mkdir",
      "<f8>": "Delete",           "<shift-d>": "Delete",
      "<f9>": "CycleSortMode",    "<shift-s>": "CycleSortMode",
      "<shift-f9>": "InvertSort",
      "<f11>": "SelectTheme",     "<shift-t>": "SelectTheme",
      "<f12>": "GlobalGitView",   "<shift-g>": "GlobalGitView",
    },
  }
}
